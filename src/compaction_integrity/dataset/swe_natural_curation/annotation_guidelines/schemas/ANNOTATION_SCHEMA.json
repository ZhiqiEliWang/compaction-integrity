{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Broader-default annotation 1.0",
  "type": "object", "additionalProperties": false,
  "required": ["annotation_id", "rubric_version", "primary_task", "candidate_role", "broad_task_constraint", "strict_sc", "broad_exclusion_reason", "strict_exclusion_reason", "primary_clause_index", "strict_primary_clause_index", "clauses", "rationale", "needs_review", "review_reason"],
  "properties": {
    "annotation_id": {"type": "string", "minLength": 1},
    "rubric_version": {"const": "1.0-broad-default"},
    "primary_task": {"type": "string", "minLength": 1},
    "candidate_role": {"enum": ["author_directive", "expected_software_behavior", "description", "reproduction_step", "template_instruction", "quoted_instruction", "mixed", "unclear"]},
    "broad_task_constraint": {"$ref": "#/$defs/label"},
    "strict_sc": {"$ref": "#/$defs/label"},
    "broad_exclusion_reason": {"enum": ["none", "not_a_constraint", "not_author_endorsed", "main_task", "uncertain"]},
    "strict_exclusion_reason": {"enum": ["none", "not_a_constraint", "main_task", "not_session_scoped", "intended_external_use", "episodic", "uncertain"]},
    "primary_clause_index": {"type": "integer", "minimum": -1},
    "strict_primary_clause_index": {"type": "integer", "minimum": -1},
    "clauses": {"type": "array", "items": {"$ref": "#/$defs/clause"}},
    "rationale": {"type": "string", "minLength": 1},
    "needs_review": {"type": "boolean"},
    "review_reason": {"type": "string"}
  },
  "$defs": {
    "label": {"enum": ["keep", "drop", "uncertain"]},
    "gate": {"enum": ["yes", "no", "uncertain"]},
    "sc_type": {"enum": ["Action", "Information", "Process", "Preference", "Output"]},
    "clause": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "start", "end", "gates", "strict_sc", "sc_types", "observable", "observability_note", "broad_task_constraint", "broad_kind", "broad_reason", "evidence"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "gates": {
          "type": "object", "additionalProperties": false,
          "required": ["is_directive", "not_main_task", "session_scoped", "no_external_use", "generic"],
          "properties": {
            "is_directive": {"$ref": "#/$defs/gate"}, "not_main_task": {"$ref": "#/$defs/gate"},
            "session_scoped": {"$ref": "#/$defs/gate"}, "no_external_use": {"$ref": "#/$defs/gate"}, "generic": {"$ref": "#/$defs/gate"}
          }
        },
        "strict_sc": {"$ref": "#/$defs/label"},
        "sc_types": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sc_type"}},
        "observable": {"$ref": "#/$defs/gate"},
        "observability_note": {"type": "string", "minLength": 1},
        "broad_task_constraint": {"$ref": "#/$defs/label"},
        "broad_kind": {"type": "string"},
        "broad_reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["source", "quote"],
          "properties": {"source": {"enum": ["candidate_paragraph", "issue_text"]}, "quote": {"type": "string", "minLength": 1}}
        }}
      }
    }
  }
}
